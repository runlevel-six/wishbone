package templates

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ string(p.Theme) } data-asset-version={ p.Asset }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="referrer" content="no-referrer"/>
			<title>
				if p.Title != "" {
					{ p.Title } &middot; { ProductName }
				} else {
					{ ProductName }
				}
			</title>
			// Every asset carries the build version. Without it a changed
			// stylesheet or icon is invisible to anyone who has been here before:
			// /static/ is served with an hour of max-age, browsers keep favicons
			// far longer than that, and the service worker caches by URL. Shipping
			// a build is meant to be the only thing needed to retire the previous
			// build's files.
			<link rel="stylesheet" href={ asset("/static/app.css", p.Asset) }/>
			// PNG first, SVG second, on purpose. A browser that cannot use the
			// SVG has something to fall back to, and the ones that prefer SVG
			// take it regardless of order.
			<link rel="icon" type="image/png" sizes="32x32" href={ asset("/static/favicon-32.png", p.Asset) }/>
			<link rel="icon" type="image/png" sizes="192x192" href={ asset("/static/icon-192.png", p.Asset) }/>
			<link rel="icon" href={ asset("/static/icon.svg", p.Asset) } type="image/svg+xml"/>
			<link rel="manifest" href={ asset("/static/manifest.webmanifest", p.Asset) }/>
			<meta name="theme-color" content={ themeColor(p.Theme) }/>
			// iOS ignores the manifest for home-screen installs and reads these
			// instead. It also has no Web Share Target — see the phone how-to.
			<link rel="apple-touch-icon" href={ asset("/static/apple-touch-icon.png", p.Asset) }/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="Wishbone"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
			<script src={ asset("/static/htmx.min.js", p.Asset) } defer></script>
			<script src={ asset("/static/app.js", p.Asset) } defer></script>
		</head>
		<body hx-headers={ csrfHeader(p.CSRF) }>
			if p.User != nil {
				<header class="topbar">
						<a class="brand" href="/">
						// Decorative: the name is right beside it, so a screen
						// reader announcing the mark too would only repeat itself.
						@BrandMark("brand-mark", 26)
						{ ProductName }
					</a>
					<nav>
						<a href="/" class={ navClass(p.Path, "/") }>Lists</a>
						<a href="/claims" class={ navClass(p.Path, "/claims") }>
							Claimed
							if p.ClaimUpdates > 0 {
								<span class="badge" title={ claimUpdatesTitle(p.ClaimUpdates) }>{ itoa(p.ClaimUpdates) }</span>
							}
						</a>
						<a href="/account" class={ navClass(p.Path, "/account") }>Account</a>
						if p.IsAdmin() {
							<a href="/admin" class={ navClass(p.Path, "/admin") }>Admin</a>
						}
					</nav>
					<form method="post" action="/logout" class="inline">
						<input type="hidden" name="csrf_token" value={ p.CSRF }/>
						<button class="link" type="submit">Sign out</button>
					</form>
				</header>
			}
			<main>
				for _, f := range p.Flashes {
					<div class={ "flash", "flash-" + f.Kind } role="status">{ f.Text }</div>
				}
				{ children... }
			</main>
			<footer class="foot">{ ProductName } &middot; family wishlists</footer>
		</body>
	</html>
}

// Bare is the chrome-free layout used by the sign-in and registration pages.
//
// Nobody is signed in here, so there is no preference to read: it always wears
// the default green. A theme is a property of an account, and the page that
// exists to find out whose account this is cannot know one yet.
templ Bare(p Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ string(p.Theme) } data-asset-version={ p.Asset }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="referrer" content="no-referrer"/>
			<title>{ p.Title } &middot; { ProductName }</title>
			// Every asset carries the build version. Without it a changed
			// stylesheet or icon is invisible to anyone who has been here before:
			// /static/ is served with an hour of max-age, browsers keep favicons
			// far longer than that, and the service worker caches by URL. Shipping
			// a build is meant to be the only thing needed to retire the previous
			// build's files.
			<link rel="stylesheet" href={ asset("/static/app.css", p.Asset) }/>
			// PNG first, SVG second, on purpose. A browser that cannot use the
			// SVG has something to fall back to, and the ones that prefer SVG
			// take it regardless of order.
			<link rel="icon" type="image/png" sizes="32x32" href={ asset("/static/favicon-32.png", p.Asset) }/>
			<link rel="icon" type="image/png" sizes="192x192" href={ asset("/static/icon-192.png", p.Asset) }/>
			<link rel="icon" href={ asset("/static/icon.svg", p.Asset) } type="image/svg+xml"/>
			<link rel="manifest" href={ asset("/static/manifest.webmanifest", p.Asset) }/>
			<meta name="theme-color" content={ themeColor(p.Theme) }/>
			// iOS ignores the manifest for home-screen installs and reads these
			// instead. It also has no Web Share Target — see the phone how-to.
			<link rel="apple-touch-icon" href={ asset("/static/apple-touch-icon.png", p.Asset) }/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content="Wishbone"/>
			<meta name="apple-mobile-web-app-status-bar-style" content="default"/>
		</head>
		<body class="centered">
			<main class="card narrow">
				<p class="brand-lockup">
					@BrandMark("brand-lockup-mark", 64)
				</p>
				<h1 class="brand-title">{ ProductName }</h1>
				for _, f := range p.Flashes {
					<div class={ "flash", "flash-" + f.Kind } role="status">{ f.Text }</div>
				}
				{ children... }
			</main>
		</body>
	</html>
}
