package templates

templ ItemForm(p Page, f ItemFormData) {
	@Layout(p) {
		<div class="page-head">
			<h1>
				if f.ItemID == "" {
					Add an item
				} else {
					Edit item
				}
			</h1>
			<a class="button" href={ templ.SafeURL("/lists/" + f.ListID) }>Back to list</a>
		</div>
		if f.FetchEnabled && f.ItemID == "" {
			<section class="card">
				<h2>Start from a link</h2>
				<form class="row" hx-post={ "/lists/" + f.ListID + "/items/preview" } hx-target="#item-form" hx-swap="outerHTML" hx-indicator="#lookup-spinner" hx-trigger={ lookupTrigger(f) }>
					<input type="url" name="url_raw" value={ f.URLRaw } placeholder="https://..." class="grow" autofocus/>
					<button class="button primary" type="submit">Look it up</button>
					<span id="lookup-spinner" class="htmx-indicator">checking…</span>
				</form>
				<p class="hint">
					Wishbone fetches the page itself so the shop never sees who is looking. If it
					cannot read the page, fill the form in by hand — that works just as well.
					<a href="/help#link-lookup">What it can and cannot read</a>.
				</p>
			</section>
		}
		@ItemFormBody(p, f)
	}
}

// ItemFormBody is swapped in place by the link lookup, so it carries its own
// element id.
templ ItemFormBody(p Page, f ItemFormData) {
	<form id="item-form" class="card stack" method="post" action={ formAction(f) } enctype="multipart/form-data">
		<input type="hidden" name="csrf_token" value={ p.CSRF }/>
		if f.FetchError != "" {
			<div class="flash flash-warn">
				Could not read that page ({ f.FetchError }). Fill in whatever you know — a
				hand-typed item is not a second-class item here.
				<a href="/help#could-not-read">What to check</a>.
			</div>
		}
		if f.NotProduct != "" {
			<div class="flash flash-info">
				<strong>That address is { f.NotProductLabel }, not one product.</strong>
				Nothing was looked up, because a page of many things has no one name and no
				one price. Go back to the shop, open the exact item you want, and copy the
				address from there — then this fills itself in.
				<a href="/help#not-a-product">How to get the right link</a>.
			</div>
		}
		if f.Blocked {
			<div class="flash flash-info">
				<strong>That shop would not let Wishbone read the page.</strong>
				It answered { itoa(f.BlockedStatus) } — a refusal aimed at anything that is not
				a person with a browser. Your link is fine and is saved as it is; the details
				are the part you have to fill in.
				if f.TitleGuessed {
					The name below was read out of the link, so the price is the one thing
					really missing — copy it from the tab you already have open.
				} else {
					Copying the name and price across from the tab you already have open is the
					fastest way.
				}
				<a href="/help#shop-refused">More about this</a>.
			</div>
		}
		if f.Suspect {
			<div id="suspect-found" class="flash flash-warn">
				<strong>This link looks wrong.</strong>
				<ul>
					for _, r := range f.SuspectReason {
						<li>{ r }</li>
					}
				</ul>
				if f.Found == nil {
					Nothing was filled in automatically. Check the link, then enter the details
					yourself if it is still the right product.
					<a href="/help#looks-wrong">Why Wishbone doubts a page</a>.
				} else {
					<p>
						Nothing was filled in automatically. Here is what that page did say, so
						you can judge it rather than take Wishbone's word for it.
						<a href="/help#looks-wrong">How to judge it</a>.
					</p>
					@foundSummary(*f.Found)
					// The values travel back in these rather than being fetched
					// again, so what gets applied is what was shown above.
					<input type="hidden" name="found_title" value={ f.Found.Title }/>
					<input type="hidden" name="found_description" value={ f.Found.Descr }/>
					<input type="hidden" name="found_price" value={ f.Found.Price }/>
					<input type="hidden" name="found_currency" value={ f.Found.Currency }/>
					<input type="hidden" name="found_image_url" value={ f.Found.ImageURL }/>
					<input type="hidden" name="found_url" value={ f.Found.URL }/>
					<input type="hidden" name="found_url_raw" value={ f.Found.URLRaw }/>
					<input type="hidden" name="found_link_status" value={ f.Found.LinkStatus }/>
					<input type="hidden" name="found_attrs" value={ f.Found.Attrs }/>
					<input type="hidden" name="found_sources" value={ f.Found.Sources }/>
					<div class="row">
						<button type="button" class="button"
							hx-post={ "/lists/" + f.ListID + "/items/preview/accept" }
							hx-include="#suspect-found" hx-target="#item-form" hx-swap="outerHTML">
							Use these details
						</button>
						if f.Found.Canonical != "" {
							<button type="button" class="button"
								hx-post={ "/lists/" + f.ListID + "/items/preview" }
								hx-vals={ hxVals("url_raw", f.Found.Canonical) }
								hx-target="#item-form" hx-swap="outerHTML" hx-indicator="#lookup-spinner">
								Look up { f.Found.Canonical } instead
							</button>
						}
					</div>
					<p class="hint">
						The second button changes which link the item points at. Take it when the
						page you landed on is the same thing under a tidier address; leave it when
						the size, color or edition might differ.
					</p>
				}
			</div>
		}
		if f.Accepted {
			<div class="flash flash-info">
				Filled in from a page Wishbone was unsure about, because you asked. Check every
				field — especially the price, and anything that pins down which version of the
				product this is.
			</div>
		}
		if believedLookup(f) && f.NothingFound {
			<div class="flash flash-info">
				That page loaded, but it did not publish any product details Wishbone could
				read — some big shops deliberately hide them from anything that is not a
				browser. Fill in what you know below; the link is saved either way.
				<a href="/help#nothing-found">More about this</a>.
			</div>
		}
		if believedLookup(f) && !f.NothingFound {
			// A lookup that filled some fields and left others empty is the most
			// common outcome of all, and reads as a half-failure unless somebody
			// says otherwise. So the cheerful flash says it too.
			<div class="flash flash-ok">
				Filled in from the page. Change anything that looks off, and fill in anything
				left empty — <a href="/help#partly-filled">the page did not say</a>.
			</div>
		}
		if len(otherErrors(f.Errors)) > 0 {
			<div class="flash flash-error">
				<strong>Some details need fixing.</strong>
				<ul>
					for _, e := range otherErrors(f.Errors) {
						<li>{ e }</li>
					}
				</ul>
			</div>
		}
		if len(f.Duplicates) > 0 {
			<div class="flash flash-info">
				This link is already on another list you can see:
				for _, d := range f.Duplicates {
					<span class="tag">{ d.ListName }: { d.ItemTitle }</span>
				}
				That may be fine — adding it anyway is allowed.
			</div>
		}
		<label>
			What is it?
			// The link box above takes the cursor when it is the obvious first
			// move. Focus falls here instead when there is no link box (editing,
			// or lookup switched off) or once a lookup has run and the fields
			// are worth checking.
			<input type="text" name="title" value={ f.Title } required maxlength="200"
				autofocus?={ f.ItemID != "" || !f.FetchEnabled || f.Extracted }/>
			if f.TitleGuessed {
				<span class="hint">
					Read out of the link itself, because the page could not be read — so it is a
					guess, and it is yours to correct. Shops write the name into the address, which
					is why this is usually close and sometimes missing its punctuation.
				</span>
			}
			if f.Errors["title"] != "" {
				<span class="error">{ f.Errors["title"] }</span>
			}
		</label>
		<label>
			Link
			<input type="url" name="url_raw" value={ f.URLRaw } maxlength="2000"/>
			if f.URL != "" && f.URL != f.URLRaw {
				<span class="hint">Saved as { f.URL }</span>
			}
		</label>
		<div class="row">
			<label class="grow">
				Price
				<input type="text" name="price" value={ f.Price } placeholder="49.99" inputmode="decimal"/>
				if f.Errors["price"] != "" {
					<span class="error">{ f.Errors["price"] }</span>
				}
			</label>
			<label>
				Currency
				<input type="text" name="currency" value={ f.Currency } maxlength="3" placeholder="USD" class="short"/>
			</label>
			<label>
				How many?
				<input type="number" name="quantity" value={ itoa(f.Quantity) } min="1" max="99" class="short"/>
				if f.Errors["quantity"] != "" {
					<span class="error">{ f.Errors["quantity"] }</span>
				}
			</label>
		</div>
		<label>
			Category
			<select name="category_id" hx-get="/category-fields" hx-target="#category-fields" hx-swap="innerHTML" hx-include="closest form">
				for _, c := range f.Categories {
					<option value={ c.ID } selected?={ c.ID == f.CategoryID }>{ c.Label }</option>
				}
			</select>
		</label>
		<div id="category-fields">
			@CategoryFields(currentCategory(f))
		</div>
		if f.ItemID != "" && f.Notes != "" && len(currentCategory(f).Fields) > 0 {
			@CategoryTranscribe(f.Notes)
		}
		<label>
			Notes for whoever buys it
			<textarea name="notes" rows="3" maxlength="2000">{ f.Notes }</textarea>
			<span class="hint">Size, color, which edition — anything that stops a wrong guess.</span>
		</label>
		<label>
			Description
			<textarea name="description" rows="3" maxlength="4000">{ f.Descr }</textarea>
		</label>
		if f.ImageSHA != "" {
			<div class="row">
				<img class="thumb" src={ "/images/" + f.ImageSHA } alt=""/>
				<label class="check">
					<input type="checkbox" name="remove_image" value="1"/>
					Remove this picture
				</label>
			</div>
		}
		<label>
			Picture
			<input type="file" name="image" accept="image/*"/>
			if f.ImageURL != "" {
				<span class="hint">A picture from the page will be saved with the item.</span>
			}
		</label>
		if f.ImageURL != "" {
			<input type="hidden" name="image_url" value={ f.ImageURL }/>
		}
		<input type="hidden" name="url" value={ f.URL }/>
		<input type="hidden" name="field_sources" value={ sourcesJSON(f.Sources) }/>
		<input type="hidden" name="link_status" value={ f.LinkStatus }/>
		<div class="row">
			<button type="submit" class="primary">
				if f.ItemID == "" {
					Add to list
				} else {
					Save changes
				}
			</button>
			<a class="button link" href={ templ.SafeURL("/lists/" + f.ListID) }>Cancel</a>
		</div>
	</form>
}

// foundSummary shows a held-back extraction without applying it.
//
// The picture is described, never rendered. Wishbone fetches images itself so
// the retailer never learns who is looking (plan §5.2); pointing an <img> at
// the retailer from the add-item form would hand over exactly that, and the
// picture is not what the owner needs to judge the link anyway.
templ foundSummary(fd FoundDetails) {
	<dl class="attrs found">
		if fd.Title != "" {
			<div><dt>Name</dt><dd>{ fd.Title }</dd></div>
		}
		if fd.Price != "" {
			<div><dt>Price</dt><dd>{ priceLabel(fd.Price, fd.Currency) }</dd></div>
		}
		if fd.Descr != "" {
			<div><dt>Description</dt><dd>{ ellipsize(fd.Descr, 240) }</dd></div>
		}
		if fd.ImageURL != "" {
			<div><dt>Picture</dt><dd>one was found, and will be saved with the item</dd></div>
		}
	</dl>
}

// CategoryFields renders the dynamic per-category inputs (plan §2.2, P3).
templ CategoryFields(c CategoryOption) {
	if len(c.Fields) > 0 {
		<fieldset class="cat-fields">
			<legend>{ c.Label } details</legend>
			for _, fl := range c.Fields {
				<label>
					{ fl.Label }
					if fl.Type == "select" {
						<select name={ "attr_" + fl.Key }>
							<option value="">—</option>
							for _, opt := range fl.Options {
								<option value={ opt } selected?={ opt == fl.Value }>{ opt }</option>
							}
						</select>
					} else if fl.Type == "number" {
						<input type="text" inputmode="decimal" name={ "attr_" + fl.Key } value={ fl.Value }/>
					} else {
						<input type="text" name={ "attr_" + fl.Key } value={ fl.Value } maxlength="200"/>
					}
				</label>
			}
		</fieldset>
	}
}

// CategoryTranscribe shows the free-text notes next to the new structured
// fields when a category is applied to an existing item, so the owner can copy
// values across by hand. Notes are never parsed automatically (plan §7 P3):
// an 80%-correct parse means a wrong gift.
templ CategoryTranscribe(notes string) {
	if notes != "" {
		<aside class="card muted-card">
			<h3>Your existing notes</h3>
			<pre class="notes">{ notes }</pre>
			<p class="hint">Copy anything useful into the fields above. Nothing is moved for you on purpose.</p>
		</aside>
	}
}
